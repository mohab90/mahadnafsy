{
  "_comment": [
    "Every entry runs the project's own vite, not whatever the registry has.",
    "",
    "These used `npx vite`. When npx cannot resolve a binary locally it fetches",
    "the newest one instead — vite 8 against a project on vite 6 — and the server",
    "dies on a config it does not understand. Nothing says so: the port never",
    "opens and the only clue is a line about installing a package.",
    "",
    "`npm exec --no --` resolves locally and fails loudly when it cannot, which",
    "is the behaviour a launcher needs."
  ],
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "--port", "4000"],
      "cwd": "admin",
      "port": 4000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "--port", "3000"],
      "cwd": "client",
      "port": 3000
    },
    {
      "name": "client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "--port", "3020", "--strictPort"],
      "cwd": "client",
      "port": 3020
    },
    {
      "name": "client-prod-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "preview", "--port", "3021", "--strictPort"],
      "cwd": "client",
      "port": 3021
    },
    {
      "name": "admin-prod-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "preview", "--port", "4001", "--strictPort"],
      "cwd": "admin",
      "port": 4001
    },
    {
      "name": "admin-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "--port", "4020", "--strictPort"],
      "cwd": "admin",
      "port": 4020
    },
    {
      "name": "live-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "--port", "4030", "--strictPort", "--mode", "live"],
      "cwd": "admin",
      "port": 4030
    },
    {
      "name": "live-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--no", "--", "vite", "--port", "3030", "--strictPort", "--mode", "live"],
      "cwd": "client",
      "port": 3030
    },
    {
      "name": "admin-fixture",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "4055",
        "--strictPort"
      ],
      "cwd": "admin",
      "port": 4055
    },
    {
      "name": "client-fixture",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "3055",
        "--strictPort"
      ],
      "cwd": "client",
      "port": 3055
    }
  ]
}