 {
  "id": "noUtcDayInQueries: no query asks the database what day or hour it is (UTC); Cairo's day comes from lib/dates.js",
  "why": "moved from a unit test that scanned api/routes and api/lib",
  "scan": {
   "dirs": [
    "api/routes",
    "api/lib"
   ],
   "exts": [
    ".js"
   ],
   "minFiles": 200,
   "mustNot": [
    {
     "source": "CURDATE\\(\\)",
     "reason": "CURDATE() is the UTC date — use sqlCairoToday() or sqlCairoDayStartUtc()"
    },
    {
     "source": "\\bCURRENT_DATE\\b",
     "reason": "CURRENT_DATE is the UTC date — use sqlCairoToday()"
    },
    {
     "source": "DATE\\(NOW\\(\\)\\)",
     "reason": "DATE(NOW()) is the UTC date — use sqlCairoToday()"
    },
    {
     "source": "HOUR\\(NOW\\(\\)\\)|MINUTE\\(NOW\\(\\)\\)",
     "reason": "NOW()'s hour is UTC — use cairoClock()"
    }
   ]
  }
 },
 {
