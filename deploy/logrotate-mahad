# /etc/logrotate.d/mahad
#
# watchdog.log and mahad-db-backup.log had no rotation at all — they grow for
# ever. They are small today (8 KB), but the watchdog appends every minute, and
# a full disk stops MariaDB, which stops everything.
/var/www/mahad-api/watchdog.log
/var/log/mahad-db-backup.log
{
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}

# The API's own log, which this file did not cover and which had reached 160 MB
# — by far the largest thing being written and the only one with no ceiling.
#
# copytruncate rather than create: systemd owns the file through
# StandardOutput=append and keeps the descriptor open, so renaming it would
# leave the API writing into an unlinked inode and the new file permanently
# empty. Copy-then-truncate keeps that descriptor valid.
#
# Rotated daily and capped at 14 files with size 50M as the trigger, so a busy
# day rotates on size instead of waiting for midnight — the point is to bound
# the total, which this holds to roughly 700 MB uncompressed and far less once
# compressed.
/var/log/mahad-api.log
{
    daily
    size 50M
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
