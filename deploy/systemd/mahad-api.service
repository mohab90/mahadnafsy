[Unit]
Description=Mahad v25 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mahad
Group=mahad
WorkingDirectory=/opt/mahad/current
EnvironmentFile=/etc/mahad/api.env
# Storage is UTC and the Cairo day is computed in lib/dates.js; the API also
# pins this itself, so the line is for tools started under this unit.
Environment=TZ=UTC
Environment=NODE_ENV=production
Environment=UV_THREADPOOL_SIZE=8
Environment=PROCESS_MANAGER=systemd
ExecStart=/usr/bin/node server.js

# ── Signing secrets ──────────────────────────────────────────────────────────
# NODE_ENV=production turns on criticalProductionPolicy(), which refuses to
# boot unless the four signing secrets are independent AND carry provenance
# saying they came from a managed store rather than a dotenv on disk.
#
# systemd credentials are that managed store. It reads each root-only file
# below and hands it to this unit alone under %d. The values never enter the
# environment block, so they cannot leak through `ps e`, /proc/PID/environ, a
# crash dump, or any child process — which is the whole point of the policy.
# The app reads them through resolveSecret()'s *_FILE support.
#
# Create the sources first, each independent and at least 48 chars:
#   install -d -m 700 /etc/mahad/secrets
#   for f in jwt session otp audit; do
#     openssl rand -hex 36 | tr -d "\n" > /etc/mahad/secrets/$f
#     chmod 400 /etc/mahad/secrets/$f
#   done
# and leave JWT_SECRET / SESSION_BINDING_SECRET / OTP_HMAC_SECRET /
# AUDIT_HMAC_SECRET unset in /etc/mahad/api.env — resolveSecret() rejects a
# secret that is configured both inline and by file.
LoadCredential=jwt:/etc/mahad/secrets/jwt
LoadCredential=session:/etc/mahad/secrets/session
LoadCredential=otp:/etc/mahad/secrets/otp
LoadCredential=audit:/etc/mahad/secrets/audit
Environment=JWT_SECRET_FILE=%d/jwt
Environment=SESSION_BINDING_SECRET_FILE=%d/session
Environment=OTP_HMAC_SECRET_FILE=%d/otp
Environment=AUDIT_HMAC_SECRET_FILE=%d/audit

# Provenance the boot-time policy verifies. Bump the two ROTATED_AT dates and
# the four references whenever the secrets are rotated; the policy fails the
# boot once they pass 370 days.
#
# ── Rotating them (the 2026-08-03 dates below are due by 2027-08-08) ────────
# Nothing fails on day 370 itself — the running process carries on — but the
# next start (a deploy, a reboot, a crash) is refused and the site is down.
# From day 330, /api/health/detailed carries `secretRotation`, the admin's
# system card («لوحة KPI للمدير» and «الإعدادات ← التحقق بخطوتين») turns amber,
# and the numbers saved under
# «تقارير الإدارة ← التقرير اليومي على واتساب» get a WhatsApp once a week.
# Rotate then, at a quiet hour, as root:
#
#   0. Once, before the first rotation: give lib/secretBox.js a key of its own.
#      Without CHANNEL_SECRET_KEY it seals the messaging-channel credentials and
#      every 2FA secret with a key derived from JWT_SECRET, so step 1 would make
#      them all unreadable and every enrolled employee would need an owner 2FA
#      reset. The admin card says «مفتاح التخزين المشفّر مستقل» once this is
#      done. Copy the
#      CURRENT JWT_SECRET into it, so what is already sealed still opens:
#        install -m 400 /etc/mahad/secrets/jwt /etc/mahad/secrets/channel
#      and add, beside the four LoadCredential lines above:
#        LoadCredential=channel:/etc/mahad/secrets/channel
#        Environment=CHANNEL_SECRET_KEY_FILE=%d/channel
#      This key is never rotated with the others.
#   1. New values, each independent and at least 48 chars:
#        for f in jwt session otp audit; do
#          openssl rand -hex 36 | tr -d "\n" > /etc/mahad/secrets/$f.new
#          chmod 400 /etc/mahad/secrets/$f.new
#          mv /etc/mahad/secrets/$f.new /etc/mahad/secrets/$f
#        done
#      Keep the old audit value root-only and offline first if past audit rows
#      must stay verifiable: the chain verifies with the current key only.
#   2. Below, set AUTH_SECRET_ROTATED_AT and AUDIT_SECRET_ROTATED_AT to today
#      (YYYY-MM-DD) and the @date of the four *_REFERENCE values to match — in
#      this file in the repository too, or the next bootstrap installs the old
#      dates back. Staging (mahad-api-staging.service) has its own copy.
#   3. systemctl daemon-reload && systemctl restart mahad-api
#      curl -s 127.0.0.1:$PORT/api/health/detailed   → "secretRotation":{"state":"ok"
#   Everyone signs in again (a new JWT_SECRET ends every session), and an OTP
#   sent before the restart is refused.
Environment=AUTH_SECRET_SOURCE=platform-secret
Environment=AUTH_SECRET_PROVIDER=systemd-credentials
Environment=AUTH_SECRET_ROTATED_AT=2026-08-03
Environment=JWT_SECRET_REFERENCE=systemd-cred:mahad/jwt@2026-08-03
Environment=SESSION_BINDING_SECRET_REFERENCE=systemd-cred:mahad/session@2026-08-03
Environment=OTP_HMAC_SECRET_REFERENCE=systemd-cred:mahad/otp@2026-08-03
Environment=AUDIT_SECRET_SOURCE=platform-secret
Environment=AUDIT_SECRET_PROVIDER=systemd-credentials
Environment=AUDIT_SECRET_REFERENCE=systemd-cred:mahad/audit@2026-08-03
Environment=AUDIT_SECRET_ROTATED_AT=2026-08-03
# always, not on-failure: the memory guard (lib/productionRuntimeGuard.js) restarts
# the API with a SIGTERM drain that exits 0, which on-failure left stopped.
Restart=always
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
SuccessExitStatus=0 143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mahad /var/cache/mahad
UMask=0027
LimitNOFILE=65535
# A ceiling, so a leak in the API cannot push MariaDB on the same 8GB box into
# the kernel's OOM killer. Above MEMORY_HEAL_LIMIT_MB (1536 by default,
# lib/productionRuntimeGuard.js), so the app's own drain-and-restart comes
# first; MemoryHigh makes the kernel reclaim hard before MemoryMax kills.
MemoryHigh=1800M
MemoryMax=2G

[Install]
WantedBy=multi-user.target
