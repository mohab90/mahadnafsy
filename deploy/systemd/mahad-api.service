[Unit]
Description=Mahad v25 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mahad
Group=mahad
WorkingDirectory=/opt/mahad/current
EnvironmentFile=/etc/mahad/api.env
Environment=NODE_ENV=production
Environment=UV_THREADPOOL_SIZE=8
Environment=PROCESS_MANAGER=systemd
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
SuccessExitStatus=0 143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mahad /var/cache/mahad
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
