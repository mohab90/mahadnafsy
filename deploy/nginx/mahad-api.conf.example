upstream mahad_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name your-production-domain.example;

    # Configure managed certificates outside the repository.
    ssl_certificate     /etc/ssl/mahad/fullchain.pem;
    ssl_certificate_key /etc/ssl/mahad/privkey.pem;

    location /api/ {
        # Strip client-supplied forwarding/geo headers. Add only headers created
        # by the trusted edge after documenting the exact proxy hop count.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://mahad_api;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }
}
