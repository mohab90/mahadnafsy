upstream mahad_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name your-client-domain.example;
    root /opt/mahad/static/client;

    ssl_certificate     /etc/ssl/mahad/fullchain.pem;
    ssl_certificate_key /etc/ssl/mahad/privkey.pem;

    location /api/ {
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://mahad_api;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }
}

server {
    listen 443 ssl http2;
    server_name your-admin-domain.example;
    root /opt/mahad/static/admin;

    ssl_certificate     /etc/ssl/mahad/fullchain.pem;
    ssl_certificate_key /etc/ssl/mahad/privkey.pem;

    location /api/ {
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://mahad_api;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }
}
