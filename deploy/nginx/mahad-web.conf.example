upstream mahad_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name your-client-domain.example;
    root /opt/mahad/static/client;

    ssl_certificate     /etc/ssl/mahad/fullchain.pem;
    ssl_certificate_key /etc/ssl/mahad/privkey.pem;

    # Debian ships nginx.conf with "gzip on;" and every gzip_types line
    # commented out, and nginx's own default type list is text/html alone — so
    # the HTML compresses and the JavaScript and CSS it pulls do not. Measured
    # on production before this was set: a first visit downloaded 579 KB of
    # assets for the public site and 795 KB for the admin, against 154 KB and
    # 223 KB compressed.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml application/manifest+json font/ttf font/otf;

    location /api/ {
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://mahad_api;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }

    # Course and bundle pages and the sitemap come from the API, so a course
    # published or edited since the release has its own title, preview and
    # place in the sitemap (api/routes/seo-pages.js). Anything but a 200 from
    # there — the API down, a page it does not know, a rate limit — falls back
    # to the release's own prerendered file, then to the app, exactly as
    # before. $request_uri keeps an Arabic slug escaped on its way through.
    location ~ ^/(c|course|bundle)/[^/]+/?$ {
        proxy_pass http://mahad_api/api/seo/page$request_uri;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 404 429 500 502 503 504 = @release_files;
    }

    location = /sitemap.xml {
        proxy_pass http://mahad_api/api/seo/sitemap.xml;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 404 429 500 502 503 504 = @release_files;
    }

    location @release_files {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }

    # The logo and the share image on the institute's own domain. Until
    # tools/fetch-brand-assets.mjs has put them in client/public/brand/, the
    # old hosted logo answers instead of the app's HTML.
    location /brand/ {
        try_files $uri @brand_fallback;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location @brand_fallback {
        return 302 https://h.top4top.io/p_3734xfq501.png;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }
}

server {
    listen 443 ssl http2;
    server_name your-admin-domain.example;
    root /opt/mahad/static/admin;

    ssl_certificate     /etc/ssl/mahad/fullchain.pem;
    ssl_certificate_key /etc/ssl/mahad/privkey.pem;

    # Debian ships nginx.conf with "gzip on;" and every gzip_types line
    # commented out, and nginx's own default type list is text/html alone — so
    # the HTML compresses and the JavaScript and CSS it pulls do not. Measured
    # on production before this was set: a first visit downloaded 579 KB of
    # assets for the public site and 795 KB for the admin, against 154 KB and
    # 223 KB compressed.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml application/manifest+json font/ttf font/otf;

    location /api/ {
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://mahad_api;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }
}
