# Static image for the two SPAs. One image, built twice — the APP build arg
# selects which app is served, so client and admin can never drift apart in
# nginx configuration.
#
# The build happens here rather than copying a dist/ from the host, so the image
# is reproducible from a clean checkout and a stale local build can never be
# published by accident.
ARG APP=client

FROM node:22-bookworm-slim AS build
ARG APP

# The repository layout is mirrored exactly: both apps import out of the sibling
# `shared/` directory with relative paths (`../shared/ui/Toast`), so building
# inside a flattened directory would fail to resolve them.
WORKDIR /repo
COPY shared/ ./shared/

WORKDIR /repo/${APP}
COPY ${APP}/package.json ${APP}/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY ${APP}/ ./
RUN npx vite build

FROM nginx:1.27-alpine AS runtime
ARG APP

# nginx:alpine renders /etc/nginx/templates/*.template through envsubst on
# startup, which is how one image serves either app.
COPY deploy/docker/nginx-spa.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /repo/${APP}/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=4s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
