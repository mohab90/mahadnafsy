# SPA delivery only. TLS, HTTP→HTTPS redirection and certificate renewal are
# Traefik's job on this host, so nothing here listens on 443 or knows about
# certificates — see deploy/nginx/*.example for the standalone-nginx variant.
#
# /api/ is NOT proxied here: Traefik routes it straight to the api service, so a
# request never passes through two proxies and X-Forwarded-For stays truthful.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Vite emits content-hashed filenames, so assets can be cached forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # index.html must never be cached, or a browser keeps loading the old
    # bundle after a release and the hashed asset it references is gone.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }

    # The service worker is re-fetched on every navigation; caching it strands
    # clients on a previous release.
    location = /sw.js {
        add_header Cache-Control "no-store" always;
    }

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
