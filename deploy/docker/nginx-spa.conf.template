# SPA delivery only. TLS, HTTP→HTTPS redirection and certificate renewal are
# Traefik's job on this host, so nothing here listens on 443 or knows about
# certificates — see deploy/nginx/*.example for the standalone-nginx variant.
#
# /api/ is NOT proxied here: Traefik routes it straight to the api service, so a
# request never passes through two proxies and X-Forwarded-For stays truthful.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # HSTS, framing, sniffing, referrer and the report-only CSP; repeated in
    # every location that sets a header of its own (nginx drops these there).
    include /etc/nginx/snippets/mahad-security-headers.conf;

    # Vite emits content-hashed filenames, so assets can be cached forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    # Course and bundle pages and the sitemap, fresh from the API between
    # releases (api/routes/seo-pages.js), falling back to the build's own files
    # on anything but a 200. Resolved per request through Docker's DNS, so this
    # container starts whether or not the api one is up; «api» is the service
    # name in docker-compose.yml.
    location ~ ^/(c|course|bundle)/[^/]+/?$ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $mahad_api http://api:3001;
        proxy_pass $mahad_api/api/seo/page$request_uri;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 404 429 500 502 503 504 = @build_files;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    location = /sitemap.xml {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $mahad_api http://api:3001;
        proxy_pass $mahad_api/api/seo/sitemap.xml;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 404 429 500 502 503 504 = @build_files;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    location @build_files {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    # The brand files, or the old hosted logo until they are in the build.
    location /brand/ {
        try_files $uri @brand_fallback;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    location @brand_fallback {
        return 302 https://h.top4top.io/p_3734xfq501.png;
    }

    # index.html must never be cached, or a browser keeps loading the old
    # bundle after a release and the hashed asset it references is gone.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    # The service worker is re-fetched on every navigation; caching it strands
    # clients on a previous release.
    location = /sw.js {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/mahad-security-headers.conf;
    }

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
