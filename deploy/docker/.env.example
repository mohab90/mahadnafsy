# Compose configuration for the Traefik host.
#
#   cp deploy/docker/.env.example .env
#
# This file is read by docker compose AND passed to the API container, so it
# carries both the routing values and everything api/.env.example lists.
# Keep it 0600 and never commit it.

# ── Routing ──────────────────────────────────────────────────────────────────
# Both must already resolve to this server: Traefik issues certificates over the
# HTTP-01 challenge, which fails if DNS does not point here yet.
CLIENT_DOMAIN=mahadnafsy.com
ADMIN_DOMAIN=admin.mahadnafsy.com

# ── Everything else ──────────────────────────────────────────────────────────
# api/.env.example is the authoritative list — copy its contents in and fill
# them. readiness:production:live enumerates precisely what is still missing,
# so run it and work down the FAIL list:
#
#   docker compose run --rm --entrypoint sh api -c "npm run readiness:production:live"
#
# Generate each of the four independent secrets separately (48+ chars):
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# JWT_SECRET=
# SESSION_BINDING_SECRET=
# OTP_HMAC_SECRET=
# AUDIT_HMAC_SECRET=
#
# DB_HOST / DB_USER / DB_PASSWORD / DB_NAME point at managed MySQL — not at a
# container on this host. DB_SSL_MODE=verify-ca and DB_SSL_CA_PATH must resolve
# inside the container, so mount the CA as a volume in docker-compose.yml.
