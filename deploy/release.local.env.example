# Copy this file to deploy/release.local.env (git-ignored — it is never committed) and fill it in once.
# deploy/release-all.sh reads it by itself, so a release is just:  bash deploy/release-all.sh
#
# The server and the SSH key need nothing here: they are read from api/.env (SSH_HOST, SSH_USER,
# SSH_PRIVATE_KEY_FILE). Set MAHAD_HOST / MAHAD_KEY below only to use a different server or key.

# Staging is behind an nginx password. The E2E gate that lets production go live needs it,
# as user:password — without it every spec answers 401 and the release stops before building.
E2E_BASIC_AUTH=user:password

# Lets the script check that GitHub Actions is green for the commit (or run «gh auth login» once instead).
# GITHUB_TOKEN=

# A student account on staging, for the signed-in payment spec (it is skipped without one).
# TEST_STUDENT_EMAIL=
# TEST_STUDENT_PASSWORD=
