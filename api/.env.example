# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_min_48_chars

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated list of admin emails and Firebase UIDs
ADMIN_EMAILS=admin@example.com
ADMIN_UIDS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@yourdomain.com

# ── WhatsApp (Green-API) ──────────────────────────────────────────────────────
WA_INSTANCE_ID=your_instance_id
WA_API_TOKEN=your_api_token

# ── Paymob ────────────────────────────────────────────────────────────────────
# CRITICAL: without this, payment verification is disabled
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id

# ── Google Sheets (optional) ──────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Server-side only — never exposed in client bundle
GEMINI_API_KEY=your_gemini_api_key

# ── SSH deployment ────────────────────────────────────────────────────────────
SSH_HOST=145.14.152.11
SSH_PORT=65002
SSH_USER=your_ssh_username
SSH_PASS=your_ssh_password

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# DB pool tuning (optional; defaults shown)
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=3000
