# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL_MODE=verify-ca
DB_SSL_CA_PATH=/run/secrets/mysql-ca.pem
DB_PROVIDER=your_managed_mysql_provider
DB_REGION=your_pinned_database_region
DB_PITR_ENABLED=true
DB_BACKUP_EVIDENCE=your_backup_restore_drill_reference
DB_BACKUP_EVIDENCE_FILE=/run/evidence/mysql-backup-restore.json
DB_BACKUP_EVIDENCE_SHA256=sha256_of_the_reviewed_backup_evidence
DB_BACKUP_VERIFIED_AT=YYYY-MM-DD
RUN_MIGRATIONS_ON_STARTUP=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SECRET_FILE=/run/secrets/mahad_jwt
# Independent HMAC key for binding the one active session to its client IP.
SESSION_BINDING_SECRET=
SESSION_BINDING_SECRET_FILE=/run/secrets/mahad_session_binding
# Independent HMAC key used to hash password-reset OTPs at rest.
OTP_HMAC_SECRET=
OTP_HMAC_SECRET_FILE=/run/secrets/mahad_otp_hmac
AUTH_SECRET_SOURCE=secret-manager
AUTH_SECRET_PROVIDER=your_production_secret_manager
JWT_SECRET_REFERENCE=your_jwt_managed_secret_version
SESSION_BINDING_SECRET_REFERENCE=your_session_managed_secret_version
OTP_HMAC_SECRET_REFERENCE=your_otp_managed_secret_version
AUTH_SECRET_ROTATED_AT=YYYY-MM-DD
# Separate signing key for the tamper-evident audit chain.
# Prefer a Secret Manager/Vault mounted file. Do not configure both variables.
AUDIT_HMAC_SECRET=
AUDIT_HMAC_SECRET_FILE=/run/secrets/mahad_audit_hmac
AUDIT_SECRET_SOURCE=secret-manager
AUDIT_SECRET_PROVIDER=your_production_secret_manager
AUDIT_SECRET_REFERENCE=your_managed_secret_version_reference
AUDIT_SECRET_ROTATED_AT=YYYY-MM-DD
DATA_RESIDENCY_REGION=your_verified_deployment_region
DATA_RESIDENCY_PROVIDER=your_cloud_provider
DATA_RESIDENCY_VERIFIED_AT=YYYY-MM-DD
DATA_RESIDENCY_EVIDENCE=your_provider_region_or_contract_evidence_reference
DATA_RESIDENCY_EVIDENCE_FILE=/run/evidence/data-residency.pdf
DATA_RESIDENCY_EVIDENCE_SHA256=sha256_of_the_reviewed_evidence_artifact

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated list of admin emails and Firebase UIDs
ADMIN_EMAILS=admin@example.com
ADMIN_UIDS=
# Control-plane access is intentionally separate from tenant administrators.
PLATFORM_ADMIN_EMAILS=platform-owner@example.com
PLATFORM_ADMIN_UIDS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
# Set to environment when deployment-owned SMTP values must override Admin settings.
SMTP_CONFIG_SOURCE=environment
# Prefer a Secret Manager/Vault mounted file. Do not configure both variables.
SMTP_PASS=
SMTP_PASS_FILE=/run/secrets/mahad_smtp_password
EMAIL_FROM=noreply@yourdomain.com
RESET_EMAIL_TEST_RECIPIENT=internal-deliverability-test@yourdomain.com

# ── Customer location and currency ────────────────────────────────────────────
# Exact number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=1
# Enable only when the edge overwrites/strips these headers from public requests.
TRUST_GEO_HEADERS=true
# HTTPS fallback. {ip} is replaced with the normalized public client IP.
GEOIP_API_URL=https://api.country.is/{ip}
GEOIP_TIMEOUT_MS=2500
GEOIP_CACHE_TTL_MS=1800000
# Optional local/test fallback only; leave empty in production.
GEO_DEFAULT_COUNTRY_CODE=
GEO_POLICY_PROVIDER=your_production_edge_or_geo_provider
GEO_POLICY_EVIDENCE=your_reviewed_edge_configuration_reference
GEO_POLICY_EVIDENCE_FILE=/run/evidence/edge-geo-policy.json
GEO_POLICY_EVIDENCE_SHA256=sha256_of_the_reviewed_edge_evidence
GEO_POLICY_VERIFIED_AT=YYYY-MM-DD
PRODUCTION_PUBLIC_BASE_URL=https://your-production-domain.example
GEO_LIVE_EXPECTED_COUNTRY_CODE=EG

# ── WhatsApp (Green-API) ──────────────────────────────────────────────────────
WA_INSTANCE_ID=your_instance_id
WA_API_TOKEN=your_api_token

# WhatsApp Meta Cloud API alternative
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_meta_phone_number_id
ADMIN_WHATSAPP_PHONE=201XXXXXXXXX

# ── Paymob ────────────────────────────────────────────────────────────────────
# CRITICAL: without this, payment verification is disabled
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_REVIEW_PENDING=true
INSTALLMENT_WRITES_ENABLED=false
PAYMENT_LINKS_ENABLED=false
# Required before enabling: an existing verified HTTPS checkout route, with {token}.
PAYMENT_LINK_CHECKOUT_URL_TEMPLATE=

# Observability / queues
SENTRY_DSN=
SENTRY_DSN_FILE=/run/secrets/mahad_sentry_dsn
SENTRY_TRACES_RATE=0.05
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_URL_FILE=/run/secrets/mahad_incident_webhook
ALERT_TIMEOUT_MS=5000
APP_RELEASE=your_release_identifier
WHATSAPP_TEST_RECIPIENT=your_internal_test_number
WHATSAPP_DELIVERY_WAIT_MS=45000
WHATSAPP_TOKEN=
WHATSAPP_TOKEN_FILE=/run/secrets/mahad_whatsapp_access_token
WHATSAPP_PHONE_ID=your_meta_phone_id
WA_API_TOKEN=
WA_API_TOKEN_FILE=/run/secrets/mahad_green_api_token
WA_INSTANCE_ID=your_green_api_instance
WHATSAPP_WEBHOOK_VERIFY_TOKEN_FILE=/run/secrets/mahad_whatsapp_verify_token
WHATSAPP_APP_SECRET_FILE=/run/secrets/mahad_whatsapp_app_secret
WHATSAPP_GREEN_WEBHOOK_SECRET_FILE=/run/secrets/mahad_whatsapp_green_webhook_secret
REDIS_URL=rediss://your_managed_redis_endpoint:6379
REDIS_PROVIDER=your_managed_redis_provider
REDIS_REGION=your_managed_redis_region
RATE_LIMIT_REDIS_ENABLED=true
PUBLIC_READ_RATE_LIMIT_PER_MINUTE=600
PUBLIC_WRITE_RATE_LIMIT_PER_MINUTE=60
JOB_LOCK_TIMEOUT_SECONDS=900

# Runtime schema policy: numbered migrations are the only source of truth.

# ── Google Sheets (optional) ──────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Server-side only — never exposed in client bundle
GEMINI_API_KEY=your_gemini_api_key

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
PRODUCT_CAPABILITY_TIER=multi-tenant-pilot
UV_THREADPOOL_SIZE=8
PROCESS_MANAGER=systemd
MEMORY_HEAL_LIMIT_MB=512

# Writable runtime data must live outside the immutable release directory.
VIDEO_UPLOAD_DIR=/var/lib/mahad/videos
BRAND_ASSET_DIR=/var/lib/mahad/branding
IMG_CACHE_DIR=/var/cache/mahad/images
DB_BACKUP_ENABLED=0
DB_BACKUP_DIR=/var/lib/mahad/db-backups

# DB pool tuning (optional; defaults shown)
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=3000
