{
  "name": "mahad-api",
  "version": "1.0.0",
  "description": "REST API — المعهد الجديد MySQL Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:auto": "node supervisor.js",
    "dev": "node kill-port.js --watch",
    "dev:clean": "node kill-port.js",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "migrate": "node tools/migrate.cjs",
    "reconcile": "node tools/reconcile.cjs",
    "backfill:payment-journals": "node tools/backfill-payment-journals.cjs",
    "smoke:live-db": "node tools/smoke-live-db.cjs",
    "uat:full-smoke": "node tools/uat-full-smoke.cjs",
    "load:smoke": "node tools/load-smoke.cjs",
    "queue:smoke": "node tools/queue-smoke.cjs",
    "readiness:production": "node tools/production-readiness.cjs",
    "readiness:production:live": "node tools/production-readiness.cjs --live-external"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@sentry/node": "^10.65.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "ssh2": "^1.17.0"
  }
}
