# ── Secrets (NEVER commit) ───────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
**/dist/
build/
.vite/
*.tsbuildinfo

# ── Logs & runtime ───────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pids/
*.pid
.staging/
.local-logs/
.img-cache/
**/.img-cache/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── Misc ─────────────────────────────────────────────────────────────────────
coverage/
e2e/test-results/
**/test-results/
artifacts/
deploy_package/
.claude/worktrees/
tmp/
*.local

# local npm cache (from e2e install)
.npm-cache/

# Claude local configuration
Claude-ADMX.zip
Claude.mobileconfig

# Schema dump for audit:columns — pull a fresh one, never commit a stale shape
schema.json

# The root package.json declares scripts and no dependencies, so a lockfile
# beside it is something npm leaves behind rather than anything to install
# from. admin/, client/ and api/ each keep their own, and those are tracked.
/package-lock.json
