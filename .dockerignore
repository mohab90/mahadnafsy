# Keep the build context small and, more importantly, keep secrets and stale
# build output from ever entering an image layer.
.git
.github
.claude
**/node_modules
**/dist
artifacts

# Never copy a real environment file into an image. Configuration is injected
# at run time through env_file / the platform's secret store.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Audit reports, deployment notes and local scratch — none of it belongs in a
# published image.
*.md
!api/**/*.md
e2e
tools/*.mjs
**/*.log
**/.DS_Store
