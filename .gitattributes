# Normalise line endings in the repository to LF.
#
# Several tests locate a region of a source file with indexOf on a literal that
# embeds "\n" (see api/tests/tenantIsolationHardening.test.js). Without this
# file, a Windows checkout with core.autocrlf=true rewrites those sources to
# CRLF, the marker never matches, the extracted region comes back empty and the
# test fails against code that is perfectly correct.
* text=auto eol=lf

# Shell scripts, spelled out rather than left to `text=auto`.
#
# A CRLF shell script does not fail loudly on Linux — it fails on its first
# line, in a way that reads like a different problem entirely. api/watchdog.sh
# shipped with CRLF and every run since it was installed died with
# `set: usage: set [-abefhkmnptuvxBCEHPT]` and `curl: (3) URL rejected`, once a
# minute, into a log nobody reads. The health check that exists to notice the
# API being down had never once checked it.
#
# The release tarball is packed from the working tree, not from git, so a
# Windows checkout's line endings reach the server as-is — which is why the
# `* text=auto` line above was not enough on its own. api/tests/shellScriptLineEndings.test.js
# fails the build rather than trusting this file to have been applied.
*.sh    text eol=lf
*.bash  text eol=lf

# Binary assets must never be touched.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.zip   binary

# Windows-only entry points need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
